{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["icn1", "hnd1", "sfo1", "fra1"],
  "functions": {
    "src/app/api/air-quality/route.ts": {
      "memory": 1024,
      "maxDuration": 25
    },
    "src/app/api/weather-ocean/route.ts": {
      "memory": 512,
      "maxDuration": 20
    },
    "src/app/api/earthquakes/route.ts": {
      "memory": 512,
      "maxDuration": 15
    },
    "src/app/api/point-inspect/route.ts": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    }
  ]
}
